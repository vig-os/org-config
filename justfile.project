# Seeded by vigOS devkit — yours to edit; upgrades never overwrite this file.
# Bugs / missing tools: https://github.com/vig-os/devkit/issues

# ===============================================================================
# PROJECT RECIPES - Team-shared customizations
# This file is git-tracked and preserved during devcontainer upgrades.
# Add team-shared recipes here that everyone on the project should use.
# ===============================================================================
# ===============================================================================
# PROJECT VARIABLES
# ===============================================================================

project := "org_config"

# Otterdog version pin (ADR-0005) — single source of truth. CI and downstream
# template repos run otterdog via `uvx` at this exact version without this
# repo's Nix flake; the pin also anchors the L1 plan-fixture format (ADR-0007).
# Bumped by Renovate; a bump implies re-checking the dev-shell path.
otterdog_version := "1.3.4"
# ===============================================================================
# INFO
# ===============================================================================

# Show project information
[group('info')]
info:
    @echo "Project: {{ project }}"

# -------------------------------------------------------------------------------
# CODE QUALITY
# -------------------------------------------------------------------------------

# Run all linters
[group('quality')]
lint:
    @if [ -f pyproject.toml ]; then uv run ruff check .; fi

# Format code
[group('quality')]
format:
    @if [ -f pyproject.toml ]; then uv run ruff format .; fi

# Run pre-commit hooks on all files (plus L0 validation, so CI's lint job gates it)
[group('quality')]
precommit: validate
    prek run --all-files

# -------------------------------------------------------------------------------
# TESTING
# -------------------------------------------------------------------------------

# Run tests with pytest
[group('test')]
test *args:
    @if [ -f pyproject.toml ]; then uv run pytest {{ args }}; fi

# Run tests with coverage
[group('test')]
test-cov *args:
    @if [ -f pyproject.toml ]; then uv run pytest --cov --cov-report=term-missing {{ args }}; fi

# -------------------------------------------------------------------------------
# DEPENDENCIES
# -------------------------------------------------------------------------------

# Sync dependencies (all groups; extras are opt-in, e.g. `just sync --all-extras`)
[group('deps')]
sync *args="--all-groups":
    @if [ -f pyproject.toml ]; then uv sync {{ args }}; fi

# Update all dependencies
[group('deps')]
update:
    uv lock --upgrade
    @just sync

# -------------------------------------------------------------------------------
# BUILD
# -------------------------------------------------------------------------------

# Clean build artifacts
[group('build')]
clean-artifacts:
    rm -rf .pytest_cache .ruff_cache .coverage htmlcov dist build *.egg-info
    find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true

# -------------------------------------------------------------------------------
# L0 VALIDATION
# -------------------------------------------------------------------------------

# actionlint + zizmor always run over .github/workflows (zizmor reads the
# repo-root zizmor.yml baseline). The jsonnet fmt check and `otterdog validate`
# skip gracefully until the config lands (#17). Additive to lint/precommit/test
# — CI drives those unchanged; this recipe is the L0 seam plan/apply reuse.
# `otterdog validate` needs `--with python-dotenv==1.1.0`: otterdog's `env`
# credential provider imports python-dotenv, an undeclared upstream dep (#16).
#
# Run L0 static validation: workflow lint/security + otterdog config (ADR-0007)
[group('L0 validation')]
validate:
    actionlint
    zizmor --offline .github/workflows
    @if [ -d otterdog ]; then find otterdog -type f \( -name '*.jsonnet' -o -name '*.libsonnet' \) -print0 | xargs -0 -r jsonnetfmt --test && echo "jsonnetfmt: OK"; else echo "jsonnetfmt: skipped (otterdog/ config lands in #17)"; fi
    @if [ -d otterdog ]; then uvx --with python-dotenv==1.1.0 --from otterdog@{{ otterdog_version }} otterdog validate --local; else echo "otterdog validate: skipped (otterdog/ config lands in #17)"; fi

# ===============================================================================
# PROJECT-SPECIFIC RECIPES
# ===============================================================================
